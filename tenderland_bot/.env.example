# Tenderland API key (get from kabinet -> Panel -> Main tab)
TL_API_KEY=your-tenderland-api-key-here

# Output directory (RaiDrive Z: mount or local path)
TL_OUTPUT_DIR=Z:/tenders

# Tenderland API base URL (do not change unless API moves)
TL_BASE_URL=https://tenderland.ru

# HTTP request timeout in seconds
TL_HTTP_TIMEOUT=120
