---
import Layout from '~/layouts/Layout.astro';
import { t } from '~/i18n';
const locale = 'ru' as const;
const dict = t(locale);
---
<Layout locale={locale} canonicalPath="/subscribe" title={dict.subscribe.title}>
  <section class="hero">
    <div class="container" style="max-width: 640px;">
      <p class="eyebrow">{dict.nav.subscribe}</p>
      <h1>{dict.subscribe.title}</h1>
      <p class="hero__sub">{dict.subscribe.body}</p>
      <p class="lead-note">В первом письме — эссе <strong>«Лестница зрелости»</strong>: почему мы бегаем по треугольнику и как из него выйти.</p>

      <form class="subscribe-form" id="subscribe-form" action="/subscribe" method="POST" novalidate>
        <input type="hidden" name="lang" value={locale} />
        <label class="field">
          <span>{dict.subscribe.nameLabel}</span>
          <input type="text" name="name" autocomplete="given-name" required />
        </label>
        <label class="field">
          <span>{dict.subscribe.emailLabel}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <button type="submit" class="btn btn--primary">{dict.subscribe.submit}</button>
        <p class="consent">{dict.subscribe.consent}</p>
      </form>
      <p class="success" id="subscribe-success" hidden>{dict.subscribe.success}</p>
    </div>
  </section>
</Layout>

<style>
  .field {
    display: block;
    margin-bottom: var(--s-3);
  }
  .field span {
    display: block;
    font-size: 0.85rem;
    color: var(--text-soft);
    margin-bottom: 6px;
  }
  .field input {
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--r-md);
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
  }
  .field input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .lead-note {
    color: var(--text-soft);
    border-left: 2px solid var(--accent);
    padding-left: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .lead-note strong { color: var(--text); }
  .consent {
    margin-top: var(--s-2);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .success {
    margin-top: var(--s-3);
    color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  // Прогрессивная отправка через glue.timofeirassokhin.com/subscribe.
  // Если JS отключён — форма сделает POST на /subscribe (404 на статике),
  // подключим server-side обработку, когда glue будет публично доступен.
  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const success = document.getElementById('subscribe-success');
  // Префилл email, если пришли с главной (лид-магнит шлёт ?email=).
  const qEmail = new URLSearchParams(location.search).get('email');
  if (qEmail && form) {
    const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement | null;
    if (emailInput) emailInput.value = qEmail;
  }
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      try {
        const r = await fetch('https://glue.timofeirassokhin.com/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (r.ok) {
          form.hidden = true;
          if (success) success.hidden = false;
        }
      } catch (err) {
        console.warn('subscribe failed', err);
      }
    });
  }
</script>
