---
import { t, localizedHref, type Locale } from '~/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---
<section class="section section--soft">
  <div class="container">
    <div class="grid-2">
      <div>
        <h2>{dict.book.title}</h2>
        <p style="color: var(--text-soft);">{dict.book.body}</p>
        <a class="btn btn--primary" href={localizedHref('/contact', locale)}>{dict.nav.contact}</a>
      </div>
      <div>
        <h3>{dict.subscribe.title}</h3>
        <p style="color: var(--text-soft);">{dict.subscribe.body}</p>
        <a class="btn btn--ghost" href={localizedHref('/subscribe', locale)}>{dict.nav.subscribe}</a>
      </div>
    </div>
  </div>
</section>
