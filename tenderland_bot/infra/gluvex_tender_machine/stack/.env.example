# ============================================================
# Gluvex Tender Machine — Phase 3 stack secrets
# ============================================================
# Реальный .env живёт в /opt/gluvex/secrets/.env (chmod 600)
# В каталоге stack/ должен быть симлинк: ln -sf /opt/gluvex/secrets/.env .env
# Этот файл (.env.example) — шаблон, коммитим в git.

# Корневой домен — поддомены подставит Caddy (crm.${DOMAIN}, litellm.${DOMAIN}, bot.${DOMAIN})
DOMAIN=gluvex.com

# ACME email для Let's Encrypt уведомлений о просрочке сертификата
ACME_EMAIL=timofei.rassokhin@gmail.com

# ---- Twenty CRM ----
# Postgres password: только буквы и цифры, без спецсимволов (требование Twenty)
# generate: openssl rand -hex 24
TWENTY_PG_PASSWORD=replace_me_with_openssl_rand_hex_24
# APP_SECRET: openssl rand -base64 32
TWENTY_APP_SECRET=replace_me_with_openssl_rand_base64_32

# ---- LiteLLM ----
# Master key для админки LiteLLM, формат sk-...
# generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-replace_me
# Salt для шифрования virtual keys в БД LiteLLM
# generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=sk-replace_me

# ---- LLM provider ключи ----
# OpenRouter — главный провайдер (обходит RU-блок Anthropic)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Резервные (опционально, если будет прямой доступ)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Phase 3.5 системный фундамент
# ============================================================

# ---- app-db (Postgres для остального стека: documents/mempalace/camunda) ----
# Root password для postgres user (master)
# generate: openssl rand -hex 24
APP_DB_PASSWORD=replace_me_openssl_rand_hex_24
# Прикладные юзеры (создаются init script'ом; пароли подставляются вторым шагом)
GLUVEX_APP_PG_PASSWORD=replace_me_openssl_rand_hex_24
MEMPALACE_PG_PASSWORD=replace_me_openssl_rand_hex_24
CAMUNDA_PG_PASSWORD=replace_me_openssl_rand_hex_24

# ---- MinIO ----
# Логин/пароль admin'а MinIO. После создания workspace-юзеров и access keys
# через UI/CLI можно ограничить use root-credentials только на bootstrap.
MINIO_ROOT_USER=gluvex_admin
# generate: openssl rand -base64 32 | tr -d "/+="
MINIO_ROOT_PASSWORD=replace_me_min_24_chars

# Twenty API token (полученный в Settings → Developers → Create API key)
TWENTY_API_TOKEN=
