# tr-com (timofeirassokhin.com) — отдельные секреты этого стека.
# Общие (DOMAIN, ACME_EMAIL, ADMIN_IP, TRAEFIK_BASIC_AUTH) живут в infra/.env

# --- Главный домен этого стека ---
TR_DOMAIN=timofeirassokhin.com

# --- Twenty CRM (инстанс B) ---
# Сгенерировать: openssl rand -base64 32
TWENTY_TR_APP_SECRET=
# Сгенерировать: openssl rand -base64 24
TWENTY_TR_PG_PASSWORD=
# API-ключ выпускается в UI Twenty после первого логина → Settings → Developers → API keys
TWENTY_TR_API_URL=https://crm.timofeirassokhin.com
TWENTY_TR_API_KEY=

# --- Listmonk (newsletter) ---
LISTMONK_PG_PASSWORD=
LISTMONK_ADMIN_USER=admin
# Сгенерировать: openssl rand -base64 24
LISTMONK_ADMIN_PASSWORD=

# --- Unisender (SMTP-релей для Listmonk + транзакционные уведомления) ---
# Получить в кабинете Unisender → Настройки → SMTP. Логин обычно совпадает с email.
UNISENDER_SMTP_HOST=smtp.unisender.com
UNISENDER_SMTP_PORT=465
UNISENDER_SMTP_USER=
UNISENDER_SMTP_PASSWORD=
# Email "от кого" — должен быть подтверждён в Unisender и иметь SPF/DKIM на домене.
UNISENDER_FROM_EMAIL=hello@timofeirassokhin.com
UNISENDER_FROM_NAME=Timofei Rassokhin

# --- Telegram-бот @timofeirassokhin_bot (отдельный от @claw1333_bot) ---
# Токен — НЕ присылать в чат, ВСТАВИТЬ ЛОКАЛЬНО в .env. Старый токен (8751559087:...) считаем
# скомпрометированным — выпустить новый через @BotFather → /mybots → Revoke Token.
TR_BOT_TOKEN=
# Telegram user IDs, которым разрешён админ-доступ (ты сам, помощник). JSON-массив.
TR_BOT_ALLOWED_ADMIN_IDS=[]

# --- Robokassa ---
# Берутся в кабинете Робокассы. Для двух паролей: Pass1 — формирование подписи, Pass2 — проверка result url.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
# По умолчанию ходим в test-mode пока не отладим интеграцию.
ROBOKASSA_TEST_MODE=1

# --- Glue webhook-secret (для подписи входящих от форм сайта и проверки нашего origin) ---
GLUE_WEBHOOK_SECRET=

# --- Cloudflare API токен (опционально, для DNS-челленджей если будем переезжать на DNS-01) ---
# Пока используем HTTP-01 через Traefik — токен не нужен. Оставлено на будущее.
# CLOUDFLARE_DNS_API_TOKEN=
