---
import Layout from '~/layouts/Layout.astro';
import { t, localizedHref } from '~/i18n';
const locale = 'en' as const;
const dict = t(locale);
---
<Layout locale={locale} canonicalPath="/shop" title={dict.shop.title}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{dict.shop.title}</p>
      <h1>{dict.shop.title}</h1>
      <p class="hero__sub">{dict.shop.placeholder}</p>
      <a class="btn btn--primary" href={localizedHref('/subscribe', locale)}>{dict.shop.cta}</a>
    </div>
  </section>
</Layout>
