# --- Общие ---
DOMAIN=13-33.pro
ACME_EMAIL=timofei.rassokhin@gmail.com

# IP, с которого разрешён доступ к админ-панелям (Traefik dashboard и т.д.)
ADMIN_IP=80.250.237.232

# --- Traefik basic auth ---
# Сгенерировать (на сервере):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'СВОЙ_ПАРОЛЬ' | sed -e 's/\$/\$\$/g'
TRAEFIK_BASIC_AUTH=

# --- Twenty CRM ---
TWENTY_APP_SECRET=
TWENTY_PG_PASSWORD=

# --- n8n ---
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=

# --- LiteLLM ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# --- OpenWebUI ---
WEBUI_SECRET_KEY=

# --- Twenty CRM (для бота, n8n, агентов) ---
TWENTY_API_URL=https://crm.13-33.pro
TWENTY_API_KEY=

# --- LLM провайдеры (через LiteLLM) ---
# OpenRouter — основной провайдер (Anthropic Sonnet/Haiku, не блокирует RU)
OPENROUTER_API_KEY=
# Anthropic — оставляем на случай, если соединение из RU когда-нибудь откроется
ANTHROPIC_API_KEY=
# OPENAI_API_KEY= (опционально — у нас локальный Whisper, для контента не нужен)

# --- Whisper (транскрипция голосовых) ---
WHISPER_URL=http://whisper:9000

# --- Personal Assistant Telegram Bot (src/) ---
# Telegram
PA_TELEGRAM_BOT_TOKEN=
PA_TELEGRAM_ALLOWED_USER_IDS=[]   # JSON-массив твоих Telegram user IDs, например [123456789]
# Прокси к api.telegram.org (на RU-хостинге выходит через Cloudflare WARP-сайдкар)
PA_TELEGRAM_PROXY=socks5://warp:1080
# Telegram-канал для автопостинга (бот должен быть админом канала)
PA_TELEGRAM_CHANNEL_ID=-1002044893213
# Google OAuth (Calendar/Drive/Docs)
PA_GOOGLE_CLIENT_ID=
PA_GOOGLE_CLIENT_SECRET=
PA_GOOGLE_REDIRECT_URI=https://bot.13-33.pro/oauth/callback
# Заметки (опционально — Drive folder ID для notes)
PA_NOTES_FOLDER_ID=
