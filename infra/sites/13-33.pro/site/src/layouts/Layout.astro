---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '13-33.pro' } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark light;
        --bg: #0e0e10;
        --fg: #e7e7ea;
        --muted: #8a8a92;
        --accent: #6c8cff;
      }
      @media (prefers-color-scheme: light) {
        :root { --bg: #fafafa; --fg: #1a1a1a; --muted: #6b6b6b; --accent: #2353cf; }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
        font-size: 17px;
      }
      .container { max-width: 720px; margin: 0 auto; padding: 4rem 1.5rem; }
      header { border-bottom: 1px solid rgba(127,127,127,.2); padding-bottom: 1.5rem; margin-bottom: 2rem; }
      header a { color: inherit; text-decoration: none; font-weight: 600; }
      h1, h2, h3 { line-height: 1.25; }
      a { color: var(--accent); }
      time, .meta { color: var(--muted); font-size: .9em; }
      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin: 1rem 0; }
      ul.posts a { font-size: 1.1em; }
      footer { color: var(--muted); margin-top: 4rem; font-size: .9em; }
      pre, code { font-family: ui-monospace, Menlo, Consolas, monospace; }
      pre { background: rgba(127,127,127,.1); padding: 1rem; border-radius: 6px; overflow-x: auto; }
      code { background: rgba(127,127,127,.1); padding: .1em .3em; border-radius: 3px; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/">13-33.pro</a>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        © {new Date().getFullYear()} · 13-33.pro
      </footer>
    </div>
  </body>
</html>
