---
import Layout from '~/layouts/Layout.astro';
import { t } from '~/i18n';
const locale = 'en' as const;
const dict = t(locale);
---
<Layout locale={locale} canonicalPath="/blog" title={dict.blog.title}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{dict.blog.title}</p>
      <h1>{dict.blog.title}</h1>
      <p class="hero__sub">{dict.blog.placeholder}</p>
    </div>
  </section>
</Layout>
