---
// EN-версия пока не делается — переключатель-заглушка.
import { type Locale } from '~/i18n';
interface Props {
  locale: Locale;
  canonicalPath: string;
}
const { } = Astro.props as Props;
---
<div class="lang" role="group" aria-label="Язык / Language">
  <span class="lang__opt lang__opt--on" aria-current="true">RU</span>
  <span class="lang__opt lang__opt--soon" title="English version coming soon" aria-disabled="true">EN</span>
</div>

<style>
  .lang {
    display: inline-flex;
    gap: 6px;
    padding: 4px;
    background: var(--bg-soft);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-pill);
  }
  .lang__opt {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    color: var(--text-muted);
    border: none;
    user-select: none;
  }
  .lang__opt--on {
    background: var(--bg-card);
    color: var(--accent);
  }
  .lang__opt--soon {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
