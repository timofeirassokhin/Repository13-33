# Build artefacts
**/node_modules/
**/dist/
**/.astro/

# Local IDE/state
.claude/

# Locally-converted SSH keys / scripts dir for local-only utils
scripts/

# Python venv
.venv/
__pycache__/
*.pyc

# Allow Gluvex Tender Machine deploy scripts despite global scripts/ ignore
!tenderland_bot/infra/gluvex_tender_machine/scripts/
!tenderland_bot/infra/gluvex_tender_machine/scripts/**
# Allow Tenderland CLI helper scripts (probe, samples, Tier-2 runner, etc.)
!tenderland_bot/scripts/
!tenderland_bot/scripts/**
